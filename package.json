{
  "name": "rodent-tracker",
  "version": "0.0.1",
  "description": "Engine for tracking a rodent in overhead behavior video: detection, arenas, zones, calibration and paradigm scoring.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./testing/*": "./tests/helpers/*.ts",
    "./*": "./src/*.ts"
  },
  "files": [
    "src",
    "tests/helpers"
  ],
  "scripts": {
    "samples": "tsx tools/samples.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "regress": "tsx tools/regress.ts --check",
    "analyze": "tsx tools/regress.ts",
    "benchmark": "tsx tools/benchmark.ts"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "mp4box": "0.5.2"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
